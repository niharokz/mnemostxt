<?xml version="1.0" encoding="utf-8"?>
<!-- Quick capture widget: brand (opens the app), "Write a note…" (opens the
     capture window), + (a new tab in the app). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/mnemostxt_w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/mnemostxt_widget_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/mnemostxt_w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingRight="10dp"
            android:text="[=]"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mnemostxt_w_hint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="Write a note…"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mnemostxt_w_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="+"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
