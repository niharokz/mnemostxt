[Desktop Entry]
Type=Application
Name=MnemoTXT
GenericName=Text Editor
Comment={{comment}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
StartupWMClass=mnemostxt
Categories=Utility;TextEditor;Development;
Keywords=mnemostxt;notepad;text;editor;markdown;notes;
{{#if mime_type}}MimeType={{mime_type}}{{/if}}
Actions=new-window;

[Desktop Action new-window]
Name=New file
Exec={{exec}}
