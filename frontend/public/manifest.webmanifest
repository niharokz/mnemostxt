{
  "name": "MnemoTXT",
  "short_name": "MnemoTXT",
  "description": "Just a notepad for your notes folder.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070b0f",
  "theme_color": "#070b0f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "shortcuts": [
    {
      "name": "Today's note",
      "short_name": "Today",
      "url": "./?open=daily"
    }
  ]
}
