# mnemostxt web — copy the lines you need into your .env (never commit .env).
# Only the variables named in docker-compose.yml reach the container.

# ── required ────────────────────────────────────────────────
# Folder with your notes on the host (mounted at /notes in the container)
NOTE_PATH=/path/to/notes
PUID=1000
PGID=1000
TZ=Asia/Kolkata

MNEMOSTXT_USER=me
# A bcrypt hash, in single quotes (so the $ signs stay as they are). Make one with:
#   docker compose run --rm -T mnemostxt hash-password <<< 'your-password'
MNEMOSTXT_PASSWORD_HASH='$2a$12$replace.this.with.your.own.hash.............'
# …or a plain password instead (MNEMOSTXT_PASSWORD_HASH wins when both are set):
# MNEMOSTXT_PASSWORD=change-me
# Signs sign-in cookies; make one with: openssl rand -hex 32
MNEMOSTXT_SECRET=

# ── demo account (optional) ─────────────────────────────────
# A second sign-in that sees built-in sample notes, read-only. Its user and
# password are shown on the sign-in card. Leave both empty for no demo.
# MNEMOSTXT_DEMO_USER=demo
# MNEMOSTXT_DEMO_PASSWORD=demo

# ── optional (defaults shown) ───────────────────────────────
# MNEMOSTXT_APP_DIR=logs/mnemostxt   app folder inside the notes folder (settings, trash, scratch); same as on your devices
# MNEMOSTXT_NOTES_NAME=notes         name shown in the sidebar
# MNEMOSTXT_LANDING=true             false: "/" goes straight to the app
# MNEMOSTXT_MAX_FILE_MB=20           largest file the web app reads or writes
# MNEMOSTXT_HIDDEN=archive,tmp       extra names to skip in Find in files
# MNEMOSTXT_BAN_AFTER=5              failed sign-ins (15 min) before a ban
# MNEMOSTXT_BAN_HOURS=24             ban length; 0 = only the 15-minute lock
# MNEMOSTXT_BAN_PRIVATE=false        also ban LAN / Tailscale addresses
# MNEMOSTXT_NETWORK=homelab          docker network your reverse proxy is on
# MNEMOSTXT_URL_APK= / _EXE= / _DEB= / _SOURCE=   About page links (default: GitLab latest release)
